              "properties": {
                "after": { "type": "string", "description": "Includes bulletins with an ID after this value." },
                "groupId": { "type": "string", "description": "Filter by process group ID." },
                "limit": { "type": "string", "description": "Maximum number of bulletins to return." },
                "sourceId": { "type": "string", "description": "Filter by source component ID." },
                "sourceName": { "type": "string", "description": "Filter by source component name (substring match)." }
