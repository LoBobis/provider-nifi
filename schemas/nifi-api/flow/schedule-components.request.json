{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PUT /flow/process-groups/{id} - Request",
  "description": "Schedules or unschedules components in a process group",
  "type": "object",
  "required": ["id", "state"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "The process group ID"
    },
    "state": {
      "type": "string",
      "description": "The desired state (RUNNING, STOPPED)"
    },
    "disconnectedNodeAcknowledged": {
      "type": "boolean"
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "../_definitions.json#/$defs/RevisionDto"
      },
      "description": "Map of component IDs to their revisions"
    }
  }
}
