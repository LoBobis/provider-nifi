    "PUT /processors/{id}": {
      "type": "object",
      "additionalProperties": false,
      "description": "Updates a processor's configuration, name, position, etc.",
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pathParameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "description": "The processor ID." }
              },
              "required": ["id"]
            },
            "body": {
              "$ref": "_definitions.json#/$defs/ProcessorEntity"
            }
          },
          "required": ["pathParameters", "body"]
        },
        "response": {
          "$ref": "_definitions.json#/$defs/ProcessorEntity"
        }
      },
      "required": ["request", "response"]
    },
