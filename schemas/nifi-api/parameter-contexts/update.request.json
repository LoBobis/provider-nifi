{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PUT /parameter-contexts/{id} - Request",
  "description": "Updates a parameter context by ID",
  "type": "object",
  "required": ["id", "revision", "component"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "The parameter context ID"
    },
    "revision": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer"
        },
        "clientId": {
          "type": "string"
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "The parameter context ID"
        },
        "name": {
          "type": "string",
          "description": "The name of the parameter context"
        },
        "description": {
          "type": "string",
          "description": "The description of the parameter context"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "parameter": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The parameter name"
                  },
                  "value": {
                    "type": ["string", "null"],
                    "description": "The parameter value"
                  },
                  "description": {
                    "type": "string",
                    "description": "The parameter description"
                  },
                  "sensitive": {
                    "type": "boolean",
                    "description": "Whether the parameter is sensitive"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
