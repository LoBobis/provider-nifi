{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PUT /controller-services/{id}/run-status - Request",
  "description": "Updates the run status of a controller service",
  "type": "object",
  "required": ["revision", "state"],
  "additionalProperties": false,
  "properties": {
    "disconnectedNodeAcknowledged": {
      "type": "boolean"
    },
    "revision": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer"
        },
        "clientId": {
          "type": "string"
        },
        "lastModifier": {
          "type": "string"
        }
      }
    },
    "state": {
      "type": "string",
      "description": "The desired state (ENABLED, DISABLED)"
    },
    "uiOnly": {
      "type": "boolean"
    }
  }
}
