{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PUT /flow/process-groups/{id}/controller-services - Response",
  "description": "Returns the activate controller services entity",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": ["string", "null"],
      "description": "The process group ID"
    },
    "state": {
      "type": ["string", "null"],
      "description": "The state (ENABLED, DISABLED)"
    },
    "disconnectedNodeAcknowledged": {
      "type": ["boolean", "null"]
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "../_definitions.json#/$defs/RevisionDto"
      },
      "description": "Map of component IDs to their revisions"
    }
  }
}
